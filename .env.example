
APP_NAME=PDF Extract Service
APP_MAX_PDF_SIZE_BYTES=10485760
APP_EXTRACT_WORKERS=1
# Límite de extracciones recibidas, en espera y activas por cada proceso de API.
APP_MAX_PENDING_EXTRACTIONS=16
APP_EXTRACTION_TIMEOUT_SECONDS=30
APP_SHUTDOWN_TIMEOUT_SECONDS=30
APP_OCR_ENABLED=false
APP_OCR_LANGUAGES=eng,spa
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
PORT=8000
